[
  {
    "description": "top-level $or with basic fields",
    "condition": {
      "$or": [
        { "name": "John" },
        { "age": 30 }
      ]
    },
    "records": [
      { "data": { "name": "John", "age": 25 }, "expected": true },
      { "data": { "name": "Frank", "age": 30 }, "expected": true },
      { "data": { "name": "John", "age": 30 }, "expected": true },
      { "data": { "name": "Frank", "age": 25 }, "expected": false }
    ]
  },
  {
    "description": "top-level empty $or never matches",
    "condition": {
      "$or": []
    },
    "records": [
      { "data": {}, "expected": false },
      { "data": { "name": "John" }, "expected": false },
      { "data": "anything", "expected": false }
    ]
  },
  {
    "description": "top-level $or with complex conditions",
    "condition": {
      "$or": [
        {
          "name": "John",
          "age": { "$gt": 25 }
        },
        {
          "tags": "engineer",
          "salary": { "$gte": 100000 }
        }
      ]
    },
    "records": [
      { "data": { "name": "John", "age": 30 }, "expected": true },
      {
        "data": {
          "name": "Frank",
          "tags": ["engineer", "developer"],
          "salary": 120000
        },
        "expected": true
      },
      { "data": { "name": "John", "age": 20 }, "expected": false },
      {
        "data": {
          "name": "Frank",
          "tags": ["developer"],
          "salary": 80000
        },
        "expected": false
      },
      {
        "data": {
          "name": "Alice",
          "age": 35,
          "tags": ["engineer"],
          "salary": 150000
        },
        "expected": true
      }
    ]
  },
  {
    "description": "top-level $or with nested object conditions",
    "condition": {
      "$or": [
        { "address": { "city": "Taipei" } },
        { "contact": { "email": "john@example.com" } }
      ]
    },
    "records": [
      {
        "data": {
          "name": "John",
          "address": { "city": "Taipei", "street": "Main St" }
        },
        "expected": true
      },
      {
        "data": {
          "name": "Frank",
          "contact": { "email": "john@example.com", "phone": "123-456-7890" }
        },
        "expected": true
      },
      {
        "data": {
          "name": "Alice",
          "address": { "city": "New York" },
          "contact": { "email": "alice@example.com" }
        },
        "expected": false
      }
    ]
  },
  {
    "description": "top-level $or with array field conditions",
    "condition": {
      "$or": [
        { "tags": "frontend" },
        { "skills": "javascript" }
      ]
    },
    "records": [
      { "data": { "name": "John", "tags": ["frontend", "developer"] }, "expected": true },
      { "data": { "name": "Frank", "skills": ["javascript", "python"] }, "expected": true },
      {
        "data": {
          "name": "Alice",
          "tags": ["backend"],
          "skills": ["java", "kotlin"]
        },
        "expected": false
      }
    ]
  },
  {
    "description": "top-level $or with existence operators",
    "condition": {
      "$or": [
        { "name": { "$exists": true } },
        { "age": { "$gt": 18 } }
      ]
    },
    "records": [
      { "data": { "name": "John" }, "expected": true },
      { "data": { "age": 25 }, "expected": true },
      { "data": { "age": 16 }, "expected": false },
      { "data": { "address": "123 Main St" }, "expected": false }
    ]
  },
  {
    "description": "nested field-level $or",
    "condition": {
      "profile": {
        "$or": [
          { "name": "Joy" },
          { "age": 18 }
        ]
      }
    },
    "records": [
      { "data": { "profile": { "name": "Joy", "age": 18 } }, "expected": true },
      { "data": { "profile": { "name": "Joy", "age": 20 } }, "expected": true },
      { "data": { "profile": { "name": "Frank", "age": 18 } }, "expected": true },
      { "data": { "profile": { "name": "Frank", "age": 20 } }, "expected": false },
      { "data": { "profile": {} }, "expected": false },
      { "data": { "profile": null }, "expected": false },
      { "data": { "name": "Joy", "age": 18 }, "expected": false },
      { "data": {}, "expected": false },
      { "data": null, "expected": false }
    ]
  }
]
