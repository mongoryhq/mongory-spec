[
  {
    "description": "top-level $every with simple field condition",
    "condition": {
      "$every": {
        "age": { "$gt": 18 }
      }
    },
    "records": [
      {
        "data": [
          { "name": "John", "age": 25 },
          { "name": "Frank", "age": 30 }
        ],
        "expected": true
      },
      {
        "data": [
          { "name": "John", "age": 25 },
          { "name": "Frank", "age": 15 }
        ],
        "expected": false
      },
      { "data": [], "expected": false },
      { "data": { "name": "John", "age": 30 }, "expected": false },
      { "data": "not an array", "expected": false },
      { "data": null, "expected": false }
    ]
  },
  {
    "description": "top-level $every with multiple field conditions",
    "condition": {
      "$every": {
        "age": { "$gte": 18 },
        "status": "active"
      }
    },
    "records": [
      {
        "data": [
          { "name": "John", "age": 25, "status": "active" },
          { "name": "Frank", "age": 30, "status": "active" }
        ],
        "expected": true
      },
      {
        "data": [
          { "name": "John", "age": 25, "status": "active" },
          { "name": "Frank", "age": 30, "status": "inactive" }
        ],
        "expected": false
      },
      {
        "data": [
          { "name": "John", "age": 16, "status": "active" },
          { "name": "Frank", "age": 30, "status": "active" }
        ],
        "expected": false
      }
    ]
  },
  {
    "description": "top-level $every with range conditions",
    "condition": {
      "$every": {
        "score": {
          "$gte": 70,
          "$lte": 100
        }
      }
    },
    "records": [
      {
        "data": [
          { "name": "John", "score": 85 },
          { "name": "Frank", "score": 90 },
          { "name": "Alice", "score": 70 }
        ],
        "expected": true
      },
      {
        "data": [
          { "name": "John", "score": 85 },
          { "name": "Frank", "score": 65 }
        ],
        "expected": false
      },
      {
        "data": [
          { "name": "John", "score": 105 },
          { "name": "Frank", "score": 85 }
        ],
        "expected": false
      }
    ]
  },
  {
    "description": "top-level $every with nested object conditions",
    "condition": {
      "$every": {
        "profile": { "verified": true },
        "score": { "$gt": 50 }
      }
    },
    "records": [
      {
        "data": [
          {
            "name": "John",
            "profile": { "verified": true, "complete": true },
            "score": 85
          },
          {
            "name": "Frank",
            "profile": { "verified": true, "complete": false },
            "score": 70
          }
        ],
        "expected": true
      },
      {
        "data": [
          {
            "name": "John",
            "profile": { "verified": true },
            "score": 85
          },
          {
            "name": "Frank",
            "profile": { "verified": false },
            "score": 70
          }
        ],
        "expected": false
      }
    ]
  },
  {
    "description": "field-level $every",
    "condition": {
      "abilities": {
        "$every": { "name": "attack" }
      }
    },
    "records": [
      {
        "data": {
          "abilities": [
            { "name": "attack", "power": 10 },
            { "name": "attack", "power": 59 }
          ]
        },
        "expected": true
      },
      {
        "data": {
          "abilities": [
            { "name": "attack", "power": 10 },
            { "name": "eat", "power": 59 }
          ]
        },
        "expected": false
      },
      { "data": { "abilities": [] }, "expected": false },
      { "data": { "abilities": null }, "expected": false },
      { "data": {}, "expected": false }
    ]
  },
  {
    "description": "top-level $every with empty condition matches non-empty arrays only",
    "condition": {
      "$every": {}
    },
    "records": [
      { "data": [{ "name": "John" }, { "name": "Frank" }], "expected": true },
      { "data": [{}], "expected": true },
      { "data": [], "expected": false },
      { "data": { "name": "John" }, "expected": false },
      { "data": "not an array", "expected": false },
      { "data": null, "expected": false }
    ]
  }
]
