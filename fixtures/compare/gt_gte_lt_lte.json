  {
    "description": "operator $gt and $lt lexicographical string comparison",
    "condition": {
      "id": {
        "$gt": "6760ff3335bacb003bfb43ef",
        "$lte": "67d3def21177ff005e59e0a4"
      }
    },
    "records": [
      { "data": { "id": "67d3def21177ff005e59e0a4" }, "expected": true },
      { "data": { "id": "67a000000000000000000000" }, "expected": true },
      { "data": { "id": "6760ff3335bacb003bfb43ef" }, "expected": false },
      { "data": { "id": "670000000000000000000000" }, "expected": false },
      { "data": { "id": "680000000000000000000000" }, "expected": false },
      { "data": { "id": 12345 }, "expected": false }
    ]
  },
  {
    "description": "ordering operators ($gt/$gte/$lt/$lte) return false for non-orderable types (null, bool, array, object)",
    "condition": {
      "$or": [
        { "a": { "$lte": null } },
        { "a": { "$gte": null } },
        { "b": { "$gte": [null] } },
        { "c": { "$lte": true } },
        { "d": { "$gte": { "x": 1 } } }
      ]
    },
    "records": [
      { "data": { "a": null }, "expected": false },
      { "data": { "b": [[1], [2]] }, "expected": false },
      { "data": { "b": [null] }, "expected": false },
      { "data": { "c": true }, "expected": false },
      { "data": { "c": false }, "expected": false },
      { "data": { "d": { "x": 1 } }, "expected": false }
    ]
  },
  {
    "description": "portable subset: IEEE-754 safe integer boundary ordering",
    "condition": {
      "id": {
        "$gte": -9007199254740991,
        "$lt": 9007199254740991
      }
    },
    "records": [
      { "data": { "id": -9007199254740991 }, "expected": true },
      { "data": { "id": 9007199254740990 }, "expected": true },
      { "data": { "id": 9007199254740991 }, "expected": false }
    ]
  }
]
